---
// src/components/GaleriaArboles.astro

const { arboles } = Astro.props;

function parseFecha(str:any) {
  const parts = str.split('/');
  return new Date(Number(parts[2]), Number(parts[1]) - 1, Number(parts[0]));
}

const arbolesOrdenados = Object.entries(arboles).map(function(entry) {
  const id   = entry[0];
  const imgs:any = entry[1];
  const sorted = imgs.slice().sort(function(a:any, b:any,) {
    return parseFecha(b.fecha).getTime() - parseFecha(a.fecha).getTime();
  });
  return { id, imagenes: sorted };
});

const total = arbolesOrdenados.length;
const sufijo = total !== 1 ? 'es' : '';
const sufijoReg = total !== 1 ? 's' : '';
---

<section class="galeria-card">
  <div class="galeria-header">
    <h3 class="galeria-title">Galería de árboles</h3>
    <p class="galeria-subtitle">{total} árbol{sufijo} registrado{sufijoReg}</p>
  </div>

  <div class="arboles-grid">
    {arbolesOrdenados.map(function(arbol) {
      const reciente = arbol.imagenes[0];
      const resto    = arbol.imagenes.slice(1);
      return (
        <article class="arbol-card">
          <div class="arbol-img-wrap">
            {reciente
              ? <img src={reciente.src} alt={'Árbol ' + arbol.id} class="arbol-img" loading="lazy" />
              : <div class="arbol-img-placeholder">Sin imagen</div>
            }
            {reciente && <span class="arbol-badge">📅 {reciente.fecha}</span>}
          </div>

          <div class="arbol-info">
            <h4 class="arbol-nombre">Árbol {arbol.id}</h4>
            <p class="arbol-total">{arbol.imagenes.length} foto{arbol.imagenes.length !== 1 ? 's' : ''}</p>
          </div>

          {resto.length > 0 && (
            <div class="arbol-miniaturas">
              {resto.map(function(img:any) {
                return (
                  <div class="miniatura-wrap">
                    <img src={img.src} alt={img.fecha} class="miniatura-img" loading="lazy" />
                    <span class="miniatura-fecha">{img.fecha}</span>
                  </div>
                );
              })}
            </div>
          )}
        </article>
      );
    })}
  </div>
</section>

<style>
.galeria-card {
  background: #fff;
  border: 1px solid var(--green-200);
  border-radius: 8px;
  padding: 1.75rem;
  box-shadow: 0 2px 20px rgba(10,61,31,0.06);
}

.galeria-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.galeria-title {
  font-family: var(--font-display);
  color: var(--green-900);
  font-size: 1.25rem;
  margin: 0;
}

.galeria-subtitle {
  font-size: 0.82rem;
  color: var(--green-500);
  max-width: unset;
  opacity: 1;
}

.arboles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.25rem;
}

.arbol-card {
  border: 1.5px solid var(--green-100);
  border-radius: 8px;
  overflow: hidden;
  background: var(--green-100);
  transition: box-shadow 0.2s, transform 0.2s;
}

.arbol-card:hover {
  box-shadow: 0 6px 24px rgba(10,61,31,0.12);
  transform: translateY(-2px);
}

.arbol-img-wrap {
  position: relative;
  aspect-ratio: 1 / 1;
  background: var(--green-200);
  overflow: hidden;
}

.arbol-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.arbol-card:hover .arbol-img {
  transform: scale(1.04);
}

.arbol-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  color: var(--green-500);
}

.arbol-badge {
  position: absolute;
  bottom: 0.5rem;
  left: 0.5rem;
  background: rgba(5, 32, 16, 0.78);
  color: var(--green-300);
  font-size: 0.7rem;
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  backdrop-filter: blur(4px);
}

.arbol-info {
  padding: 0.75rem 0.85rem 0.5rem;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.arbol-nombre {
  font-family: var(--font-display);
  font-size: 1rem;
  color: var(--green-900);
}

.arbol-total {
  font-size: 0.72rem;
  color: var(--green-500);
  max-width: unset;
  opacity: 1;
}

.arbol-miniaturas {
  display: flex;
  gap: 4px;
  padding: 0 0.85rem 0.85rem;
  overflow-x: auto;
}

.miniatura-wrap {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.miniatura-img {
  width: 44px;
  height: 44px;
  object-fit: cover;
  border-radius: 4px;
  border: 1.5px solid var(--green-200);
  transition: border-color 0.2s;
}

.miniatura-img:hover {
  border-color: var(--green-500);
}

.miniatura-fecha {
  font-size: 0.58rem;
  color: var(--green-600);
  white-space: nowrap;
}
</style>