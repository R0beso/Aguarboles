---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import CalendarioRiegos from '../components/CalendarioRiegos.astro';

import data from '../../public/data.json';

const { riegos, abonos, arboles } = data;

const arbolesEntries = Object.entries(arboles) as [string, { fecha: string; src: string }[]][];
---

<Layout title="Inicio — Árboles Aguacates" description="Seguimiento de árboles de aguacate en Culiacán">

  <!-- ════════════════════════════════ HERO ════════════════════════════════ -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Culiacán, Sinaloa</p>
      <h1 class="hero__title">Árboles de<br /><em>Aguacate</em></h1>
      <p class="hero__subtitle">Registro de riegos, abonos y seguimiento fotográfico de cada árbol (Apartir de febrero de 2026).</p>
      <br />
      <p class="hero__subtitle">Ultima actualizacion: 21 de Mayo de 2026</p>
    </div>
    <div class="hero__bg-circle" aria-hidden="true"></div>
  </section>

  <!-- ════════════════════════════ CALENDARIO ══════════════════════════════ -->
  <section class="section">
    <div class="container">
      <CalendarioRiegos riegos={riegos} abonos={abonos} />
    </div>
  </section>

  <!-- ══════════════════════════════ GALERÍA ═══════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="sec-header">
        <h2 class="sec-titulo sec-titulo--dark">Galería de Árboles</h2>
        <p class="sec-sub">Evolución fotográfica por árbol</p>
      </div>

      <div class="galeria-grid">
        {arbolesEntries.map(([id, fotos]) => (
          <div
            class="arbol-card"
            data-total={fotos.length}
          >
            <!-- Encabezado de la tarjeta -->
            <div class="arbol-card__header">
              <div class="arbol-card__id">
                <span class="arbol-card__id-lbl">Árbol</span>
                <span class="arbol-card__id-num">{id}</span>
              </div>
              {fotos.length > 1 && (
                <span class="arbol-card__badge">{fotos.length} fotos</span>
              )}
            </div>

            <!-- Zona de imagen -->
            <div class="arbol-card__img-wrap">
              {fotos.map((foto, i) => (
                <img
                  src={`.${foto.src}`}
                  alt={`Arbol ${id} - ${foto.fecha}`}
                  class:list={['arbol-card__img', { 'is-active': i === 0 }]}
                  data-index={i}
                  loading="lazy"
                />
              ))}
            </div>

            <!-- Fecha -->
            <div class="arbol-card__overlay">
              {fotos.map((foto, i) => (
                <span
                  class:list={['arbol-card__fecha', { 'is-active': i === 0 }]}
                  data-index={i}
                >
                  {foto.fecha}
                </span>
              ))}
            </div>

            <!-- Flechas (solo si hay más de 1 foto) -->
            {fotos.length > 1 && (
              <div class="arbol-card__nav">
                <button class="arbol-card__btn arbol-card__btn--prev" aria-label="Anterior">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <polyline points="15 18 9 12 15 6" />
                  </svg>
                </button>
                <button class="arbol-card__btn arbol-card__btn--next" aria-label="Siguiente">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
              </div>
            )}

            <!-- Dots -->
            {fotos.length > 1 && (
              <div class="arbol-card__dots">
                {fotos.map((_, i) => (
                  <button
                    class:list={['arbol-card__dot', { 'is-active': i === 0 }]}
                    data-index={i}
                    aria-label={`Foto ${i + 1}`}
                  />
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<!-- ═══════════════════════════════ ESTILOS ══════════════════════════════ -->
<style>
/* ── Hero ── */
.hero {
  position: relative;
  min-height: 45vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(135deg, var(--green-950, #052e16) 0%, var(--green-900, #14532d) 60%, var(--green-800, #166534) 100%);
}
.hero__inner {
  position: relative;
  z-index: 2;
  padding-top: 3rem;
  padding-bottom: 3rem;
}
.hero__eyebrow {
  font-size: 0.8rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--green-400, #4ade80);
  margin-bottom: 1rem;
  opacity: 0.9;
}
.hero__title {
  font-family: var(--font-display, serif);
  font-size: clamp(2.5rem, 7vw, 5rem);
  color: var(--cream, #f5f0e8);
  line-height: 1.05;
  margin-bottom: 1rem;
}
.hero__title em { color: var(--green-400, #4ade80); font-style: italic; }
.hero__subtitle { color: var(--green-200, #bbf7d0); font-size: 1rem; max-width: 42ch; opacity: 0.85; }
.hero__bg-circle {
  position: absolute;
  right: -5%; top: 50%;
  transform: translateY(-50%);
  width: 400px; height: 400px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--green-700, #15803d) 0%, transparent 70%);
  opacity: 0.2;
  pointer-events: none;
}

/* ── Secciones ── */
.section {
  padding: 3rem 0;
}
.sec-header {
  margin-bottom: 1.75rem;
}
.sec-titulo {
  font-family: var(--font-display, serif);
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  color: var(--cream, #f5f0e8);
  margin: 0 0 0.2rem 0;
}
.sec-sub {
  color: var(--green-400, #4ade80);
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin: 0;
  opacity: 0.8;
}

/* ── Galería ── */
.galeria-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}
.sec-titulo--dark {
  color: #1a1a1a;
}

.arbol-card {
  background: #166534;
  border: 1px solid #15803d;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.arbol-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px -8px rgba(0,0,0,0.5);
}

.arbol-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 0.8rem 0.4rem;
}
.arbol-card__id {
  display: flex;
  align-items: baseline;
  gap: 0.3rem;
}
.arbol-card__id-lbl {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #4ade80;
  opacity: 0.7;
}
.arbol-card__id-num {
  font-size: 1.35rem;
  font-weight: 700;
  color: #f5f0e8;
  line-height: 1;
}
.arbol-card__badge {
  font-size: 0.62rem;
  background: rgba(74,222,128,0.15);
  color: #4ade80;
  border: 1px solid rgba(74,222,128,0.3);
  padding: 0.12rem 0.5rem;
  border-radius: 99px;
}

.arbol-card__img-wrap {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #052e16;
  overflow: hidden;
}
.arbol-card__img {
  position: relative;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 6px;
  opacity: 0;
  transition: opacity 0.3s ease;
  display: none;
}
.arbol-card__img.is-active {
  opacity: 1;
  display: block;
}

.arbol-card__overlay {
  display: flex;
  justify-content: center;
  padding: 0 1rem 0.6rem;
  pointer-events: none;
}
.arbol-card__fecha {
  display: none;
  font-size: 0.7rem;
  color: #fff;
  letter-spacing: 0.06em;
  background: rgba(0,0,0,0.62);
  backdrop-filter: blur(4px);
  padding: 0.2rem 0.55rem;
  border-radius: 6px;
}
.arbol-card__fecha.is-active { display: inline-block; }

.arbol-card__nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0.5rem 0.4rem;
}
.arbol-card__btn {
  width: 1.9rem;
  height: 1.9rem;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  border: 1px solid rgba(255,255,255,0.2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.15s, transform 0.15s;
}
.arbol-card__btn:hover { background: rgba(0,0,0,0.75); transform: scale(1.1); }

.arbol-card__dots {
  display: flex;
  justify-content: center;
  gap: 0.35rem;
  padding: 0.55rem 0.75rem;
}
.arbol-card__dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: rgba(74,222,128,0.25);
  border: none;
  cursor: pointer;
  padding: 0;
  transition: background 0.2s, transform 0.2s;
}
.arbol-card__dot.is-active {
  background: #4ade80;
  transform: scale(1.35);
}
</style>

<!-- ════════════════════════════════ SCRIPTS ═════════════════════════════ -->
<script>
  document.querySelectorAll('.arbol-card').forEach(card => {
    const el = card as HTMLElement;
    const total = parseInt(el.dataset.total ?? '1', 10);
    if (total <= 1) return;

    let current = 0;

    const imgs   = el.querySelectorAll<HTMLElement>('.arbol-card__img');
    const fechas = el.querySelectorAll<HTMLElement>('.arbol-card__fecha');
    const dots   = el.querySelectorAll<HTMLElement>('.arbol-card__dot');

    function goTo(index: number) {
      imgs[current].classList.remove('is-active');
      fechas[current].classList.remove('is-active');
      dots[current].classList.remove('is-active');

      current = (index + total) % total;

      imgs[current].classList.add('is-active');
      fechas[current].classList.add('is-active');
      dots[current].classList.add('is-active');
    }

    el.querySelector('.arbol-card__btn--prev')?.addEventListener('click', () => goTo(current - 1));
    el.querySelector('.arbol-card__btn--next')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Swipe táctil
    let startX = 0;
    const wrap = el.querySelector('.arbol-card__img-wrap')!;
    wrap.addEventListener('touchstart', e => { startX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', e => {
      const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
    }, { passive: true });
  });
</script>